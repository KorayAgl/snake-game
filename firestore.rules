rules_version = '2';

// Regeln für die Snake-Bestenliste.
// Jeder darf lesen. Schreiben nur gültige Einträge, und ein Rekord darf nur steigen.
service cloud.firestore {
  match /databases/{database}/documents {

    function isBoard(board) {
      return board in ['scores_easy', 'scores_normal', 'scores_hard'];
    }

    function validEntry(player) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'ts'])
        && d.keys().hasAll(['name', 'score', 'ts'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 16
        && d.name.matches('^[A-Za-z0-9ÄÖÜäöüß .-]+$')
        && d.name.lower() == player
        && d.score is int
        && d.score >= 1 && d.score <= 400
        && d.ts == request.time;
    }

    match /{board}/{player} {
      allow read:   if isBoard(board);
      allow create: if isBoard(board) && validEntry(player);
      allow update: if isBoard(board) && validEntry(player)
                    && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
